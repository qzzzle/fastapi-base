# Environment
ENV=dev

# Project
SECRET_KEY=please_change_me

# Database (choose one engine and matching PORT)
DB=postgresql
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=app

# If you prefer MySQL:
# DB=mysql
# DB_USER=root
# DB_PASSWORD=yourpass
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=app

# CORS (comma-separated). Leave empty for local smoke tests.
BACKEND_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
